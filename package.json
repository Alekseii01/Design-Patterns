{
  "name": "data-processing-system",
  "version": "1.0.0",
  "description": "Data processing system using Adapter and Visitor design patterns",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/demo.js",
    "dev": "ts-node src/demo.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rimraf dist",
    "lint": "eslint src/**/*.ts",
    "demo": "npm run build && npm start"
